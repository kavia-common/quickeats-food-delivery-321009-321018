# PostgreSQL (provided by platform; names must match the database container contract)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# JWT (set this in real deployments; do not use the dev default in production)
JWT_SECRET=change-me
JWT_ISSUER=quickeats
JWT_AUDIENCE=quickeats-web
JWT_EXP_MINUTES=1440

# CORS (comma-separated; "*" for all)
# In preview environments, the platform provides ALLOWED_ORIGINS (recommended).
ALLOWED_ORIGINS=http://localhost:3000

# Backwards-compatible alias still supported by the backend:
CORS_ALLOW_ORIGINS=*
